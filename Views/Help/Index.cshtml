@model SAMS.Models.Help.HelpPageViewModel
@{
    ViewData["Title"] = "Help";
}

<div class="container py-3">
    <div class="mb-4">
        <h1 class="mb-1">Role-Based Help</h1>
        <p class="text-muted mb-1">This page explains what you are allowed and not allowed to do based on your assigned role(s).</p>
        <small class="text-muted">Generated at @Model.GeneratedAtUtc.ToString("u") for @Model.DisplayName</small>
    </div>

    @if (!Model.Sections.Any())
    {
        <div class="alert alert-warning" role="alert">
            No role-specific help sections were resolved for your account. Contact an administrator if you think this is incorrect.
        </div>
    }
    else
    {
        foreach (var roleSection in Model.Sections)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">@roleSection.RoleName</h2>
                </div>
                <div class="card-body">
                    <p>@roleSection.Summary</p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h3 class="h6 text-success">Allowed</h3>
                            <ul class="mb-0">
                                @foreach (var allowed in roleSection.AllowedBehaviors)
                                {
                                    <li>@allowed</li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <h3 class="h6 text-danger">Not Allowed</h3>
                            <ul class="mb-0">
                                @foreach (var blocked in roleSection.NotAllowedBehaviors)
                                {
                                    <li>@blocked</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
