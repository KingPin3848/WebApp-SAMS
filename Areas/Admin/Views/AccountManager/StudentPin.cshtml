@model SAMS.Areas.Admin.Controllers.StudentPinInputModel
@{
    ViewData["Title"] = "Edit student PIN";
    var userId = (string)ViewData["UserId"]!;
}

<h1>Edit student PIN</h1>
<form asp-action="StudentPin" asp-route-id="@userId" method="post">
    <div asp-validation-summary="All" class="text-danger pb-2"></div>
    <div class="form-floating pb-2">
        <input asp-for="StudentPin" class="form-control" type="number" min="-1" max="9999" required />
        <label asp-for="StudentPin"></label>
        <span asp-validation-for="StudentPin" class="text-danger"></span>
    </div>
    <div class="form-group pt-4">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a class="p-3" asp-action="Index">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
